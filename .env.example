# Copy to .env and adjust as needed
NODE_ENV=development
PORT=3000

# MySQL (Aiven en producción)
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password_here
DB_NAME=usuarios
DB_SSL=false

# JWT: en producción OBLIGATORIO, mínimo 32 caracteres (el server aborta si falta)
JWT_SECRET=change_this_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES=24h

# Token para /api/ops/stats. En producción es OBLIGATORIO: sin él el endpoint
# responde 404 (antes era público y exponía tráfico y estado interno).
# Consulta: curl -H "X-Ops-Token: <token>" https://.../api/ops/stats
OPS_TOKEN=

# Almacenamiento de imágenes y modelos de usuario. Sin definir, se usa la carpeta
# del backend, que en Render es EFÍMERA (se borra en cada reinicio).
DATA_DIR=

# CORS: orígenes permitidos (separados por coma). En producción el dominio del frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Flask (opcional si se ejecutan aparte)
FLASK_REC_URL=http://localhost:5000
FLASK_CAPTURE_URL=http://localhost:5001

# URL pública de la app (se usa en los enlaces de recuperación de contraseña)
APP_URL=http://localhost:3000

# SMTP para el envío de correos de recuperación (opcional).
# Si NO se configura: en desarrollo el backend devuelve el enlace de reset en la
# respuesta (para poder probar); en producción solo lo registra en los logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# RESEND (alternativa al SMTP para el envío de correos). Resend es una API HTTP,
# no SMTP: basta con la API key. Si hay RESEND_API_KEY se usa Resend por encima del SMTP.
# 'from' en Resend debe usar un dominio verificado (ej: "Traductor <envios@tudominio.com>").
# El plan free permite 100 correos/día, sin tarjeta.
RESEND_API_KEY=
RESEND_FROM=

# Destinatario de los mensajes de contacto/soporte (formulario "Contactar").
# Si se deja vacío, se usa SMTP_USER o 'soporte@traductor.local'.
SUPPORT_EMAIL=